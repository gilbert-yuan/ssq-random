# Copy this file to .env and update the values for your environment.

# Local Node server
HOST=127.0.0.1
PORT=5173
NODE_ENV=production

# PostgreSQL connection used by server.js and smoke tests.
# Local PostgreSQL example:
DATABASE_URL=postgresql://yuan:qq111111@127.0.0.1:5432/ssq_random

# Set to 1 only when your PostgreSQL server requires SSL.
DB_SSL=0

# Optional application defaults
DEFAULT_USER_ID=default
SESSION_COOKIE_NAME=ssq_session
SESSION_TTL_DAYS=30

# Docker Compose defaults. docker-compose.yml uses these when present.
APP_PORT=5173
POSTGRES_DB=ssq_random
POSTGRES_USER=yuan
POSTGRES_PASSWORD=qq111111
