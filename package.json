{
  "name": "myerp-ssq-advisor",
  "version": "0.1.0",
  "private": true,
  "description": "双色球一键选号、历史分布分析、趋势建议和社区推荐号抓取工具",
  "scripts": {
    "start": "pm2 startOrRestart ecosystem.config.cjs --update-env",
    "start:node": "node server.js",
    "restart": "pm2 restart ssq-random --update-env",
    "stop": "pm2 stop ssq-random",
    "logs": "pm2 logs ssq-random",
    "status": "pm2 status ssq-random",
    "test": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "pm2": "^7.0.1"
  },
  "engines": {
    "node": ">=22"
  }
}
