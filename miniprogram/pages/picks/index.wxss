.page {
  padding: 28rpx 24rpx 44rpx;
}

.hero-card {
  margin-top: 0;
  padding: 28rpx;
  background: linear-gradient(145deg, rgba(255, 255, 255, 0.95), rgba(232, 244, 248, 0.86));
}

.hero-eyebrow {
  display: block;
  color: #4d5b69;
  font-size: 20rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
  color: #23303d;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.06;
}

.hero-subtitle {
  display: block;
  margin-top: 12rpx;
  color: #244ba8;
  font-size: 26rpx;
  font-weight: 700;
}

.hero-description {
  display: block;
  margin-top: 16rpx;
  color: #4d5b69;
  font-size: 24rpx;
  line-height: 1.7;
}

.hero-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 22rpx;
}

.announce {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 16rpx 18rpx;
  border: 4rpx solid #23303d;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  box-shadow: 6rpx 6rpx 0 #23303d;
}

.announce-tag {
  flex-shrink: 0;
}

.announce-swiper {
  flex: 1;
  height: 36rpx;
}

.announce-item {
  height: 36rpx;
  display: flex;
  align-items: center;
}

.announce-text {
  color: #23303d;
  font-size: 24rpx;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  margin-top: 20rpx;
}

.summary-item {
  min-width: 0;
  padding: 20rpx 14rpx;
  border: 4rpx solid #23303d;
  border-radius: 24rpx;
  box-shadow: 6rpx 6rpx 0 #23303d;
  text-align: center;
}

.summary-yellow {
  background: rgba(255, 239, 138, 0.82);
  transform: rotate(-1deg);
}

.summary-blue {
  background: rgba(219, 234, 254, 0.88);
  transform: rotate(0.9deg);
}

.summary-pink {
  background: rgba(255, 214, 231, 0.86);
  transform: rotate(-0.6deg);
}

.summary-white {
  background: rgba(255, 255, 255, 0.96);
  transform: rotate(0.5deg);
}

.summary-value {
  display: block;
  color: #23303d;
  font-size: 34rpx;
  font-weight: 800;
  word-break: break-word;
}

.amount {
  font-size: 28rpx;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  color: #4d5b69;
  font-size: 22rpx;
  font-weight: 700;
}

.group-title {
  display: block;
  margin-top: 22rpx;
  color: #23303d;
  font-size: 24rpx;
  font-weight: 700;
}

.number-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}

.pick {
  width: 72rpx;
  height: 72rpx;
  border: 3rpx solid #23303d;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.86);
  color: #23303d;
  box-shadow: 4rpx 4rpx 0 #23303d;
  font-size: 24rpx;
  font-weight: 700;
}

.pick-red-active {
  background: #ef4444;
  color: #ffffff;
}

.pick-blue-active {
  background: #3b82f6;
  color: #ffffff;
}

.ticket-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border: 4rpx dashed rgba(35, 48, 61, 0.24);
  border-radius: 24rpx;
  background: rgba(255, 254, 245, 0.84);
}

.ticket-reason,
.ticket-type {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.65;
}

.ticket-reason {
  color: #4d5b69;
}

.ticket-type {
  color: #0d7b56;
  font-weight: 700;
}

.position-list {
  margin-top: 18rpx;
  display: grid;
  gap: 12rpx;
}

.position-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 16rpx;
  border: 3rpx solid rgba(35, 48, 61, 0.14);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.88);
}

.position-label {
  width: 170rpx;
  color: #4d5b69;
  font-size: 24rpx;
  flex-shrink: 0;
}

.position-value {
  flex: 1;
  color: #23303d;
  font-size: 24rpx;
  font-weight: 700;
}

.position-rank {
  color: #0d7b56;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.save-button {
  margin-top: 18rpx;
}

.list-count {
  margin-top: 14rpx;
  color: #4d5b69;
  font-size: 22rpx;
}

.record-card {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 4rpx solid #23303d;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.88);
  box-shadow: 6rpx 6rpx 0 #23303d;
}

.pinned-card {
  background: rgba(255, 250, 240, 0.96);
}

.record-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.record-status-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}

.record-status {
  padding: 8rpx 14rpx;
  border: 3rpx solid rgba(35, 48, 61, 0.14);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.record-status.won {
  background: #d1fae5;
  color: #0d7b56;
}

.record-status.pending {
  background: #ffedd5;
  color: #b45309;
}

.record-status.lost {
  background: #eef2f6;
  color: #4d5b69;
}

.record-amount {
  color: #23303d;
  font-size: 24rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.pinned-badge {
  padding: 8rpx 12rpx;
  border: 3rpx solid #23303d;
  border-radius: 999rpx;
  background: #ffef8a;
  color: #23303d;
  font-size: 22rpx;
  font-weight: 700;
}

.compact {
  margin-top: 14rpx;
}

.record-meta,
.record-check,
.record-draw {
  display: block;
  margin-top: 12rpx;
  color: #4d5b69;
  font-size: 24rpx;
  line-height: 1.6;
}

.record-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 16rpx;
}

.mini-action {
  flex: 1;
  height: 72rpx;
  font-size: 24rpx;
}

.danger {
  background: #fee2e2;
  color: #b91c1c;
}
